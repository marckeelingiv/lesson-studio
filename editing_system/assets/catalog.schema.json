{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editing System Asset Catalog",
  "description": "Typed registry of reusable editing assets across 7 asset classes.",
  "type": "object",
  "required": ["schema_version", "assets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "subtype",
          "aspect_ratios",
          "tags",
          "license",
          "attribution",
          "path",
          "status",
          "usage_rules"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "class": {
            "type": "string",
            "enum": [
              "tokens",
              "layouts",
              "frameworks",
              "heroes",
              "motion",
              "graphics",
              "audio"
            ]
          },
          "subtype": {
            "type": "string",
            "minLength": 1
          },
          "aspect_ratios": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["16:9", "9:16", "any"]
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["active", "planned"]
          },
          "usage_rules": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
